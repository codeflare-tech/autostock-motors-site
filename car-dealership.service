[Unit]
Description=AutoStock Motors Car Dealership (FastAPI)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bongani
WorkingDirectory=/home/bongani/car-dealership
ExecStart=/home/bongani/car-dealership/.venv/bin/uvicorn main:app --host 0.0.0.0 --port 8123
Restart=on-failure
RestartSec=5
StandardOutput=append:/home/bongani/car-dealership/server.log
StandardError=append:/home/bongani/car-dealership/server.log

[Install]
WantedBy=default.target
